<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scopes package restore for this repo to nuget.org only. The machine has an
    additional private feed configured globally (an Azure Artifacts feed for other
    projects) that this repo has no credentials for and does not need — <clear/>
    prevents that feed from being consulted here without touching the global config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
